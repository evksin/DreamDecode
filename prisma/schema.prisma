// DreamDecode Prisma Schema
// PostgreSQL (NeonDB) через Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Модель для записей снов
model Dream {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(255)
  description String   @db.Text
  
  // Метаданные сна
  emotion     String?  @db.VarChar(50)
  clarity     Int?     @db.SmallInt
  lucid       Boolean  @default(false)
  
  // AI анализ
  analysis    String?  @db.Text
  interpretation String? @db.Text
  
  // Теги и символы
  tags        String[] @default([])
  symbols     Symbol[]
  
  // Дата и время
  dreamDate   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([createdAt])
  @@index([dreamDate])
}

// Модель для повторяющихся символов
model Symbol {
  id          String   @id @default(cuid())
  name        String   @unique @db.VarChar(100)
  meaning     String   @db.Text
  frequency   Int      @default(0)
  
  dreams      Dream[]
  
  createdAt   DateTime @default(now())
}

// Модель для пользователей (будущее)
model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  name      String?
  image     String?
  emailVerified DateTime?
  
  birthDate DateTime?
  birthTime String?
  
  theme     String   @default("dark")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts  Account[]
  sessions  Session[]
  prompts   Prompt[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Prompt {
  id        String   @id @default(cuid())
  title     String   @db.VarChar(255)
  content   String   @db.Text
  isPrivate Boolean  @default(true)
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// Analytics для графиков
model DreamAnalytics {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  
  totalDreams      Int @default(0)
  avgClarity       Float @default(0)
  topEmotion       String? @db.VarChar(50)
  topSymbol        String? @db.VarChar(100)
  
  createdAt DateTime @default(now())
  
  @@index([date])
}




